# Kopa Connect — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# ============================
# DATABASE
# ============================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ============================
# AUTHENTICATION
# ============================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ============================
# VERCEL BLOB (File Storage)
# ============================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# ============================
# APP CONFIG
# ============================
VITE_APP_NAME=Kopa Connect
VITE_API_URL=/api
VITE_APP_URL=https://kopaconnect.vercel.app

# ============================
# CAMP CONFIG
# ============================
# Duration of NYSC orientation camp in days
CAMP_DURATION_DAYS=21

# ============================
# EMAIL (Optional - for password reset)
# ============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@kopaconnect.com
SMTP_PASS=your-app-password

# ============================
# ADMIN
# ============================
# Super admin email (auto-promoted on registration if matches)
SUPER_ADMIN_EMAIL=admin@kopaconnect.com
